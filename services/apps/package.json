{
  "name": "nanocodex-dynamic-apps-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "npm run build:ui && npm run build:control && npm run build:runtime",
    "build:control": "wrangler deploy --dry-run --outdir dist/control",
    "build:runtime": "wrangler deploy --config wrangler.runtime.jsonc --dry-run --outdir dist/runtime",
    "build:ui": "vite build",
    "check": "npm run typecheck && npm test && npm run build",
    "deploy": "npm run build:ui && npm run deploy:control && npm run deploy:runtime",
    "deploy:control": "wrangler deploy",
    "deploy:runtime": "wrangler deploy --config wrangler.runtime.jsonc",
    "dev": "npm run build:ui && wrangler dev --remote",
    "dev:runtime": "wrangler dev --config wrangler.runtime.jsonc --remote",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "^4.0.18",
    "wrangler": "^4.115.0"
  },
  "dependencies": {
    "@cloudflare/worker-bundler": "0.2.3",
    "isomorphic-git": "1.41.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
