@@ -0,0 +1,78 @@
+const MULTIPART_PART_BYTES = 5 * 1024 * 1024;
+
+export async function putMultipartStream(bucket, key, stream, expectedSize, options) {
+  if (!Number.isSafeInteger(expectedSize) || expectedSize < 0) {
+    throw new Error(`Invalid stream size for ${key}: ${expectedSize}`);
+  }
+  const upload = await bucket.createMultipartUpload(key, options);
+  const reader = stream.getReader();
+  const buffered = [];
+  const parts = [];
+  let bufferedBytes = 0;
+  let observedBytes = 0;
+  let partNumber = 1;
+  try {
+    while (true) {
+      const { done, value } = await reader.read();
+      if (done) break;
+      if (!(value instanceof Uint8Array)) {
+        throw new Error(`CI stream yielded a non-byte chunk for ${key}`);
+      }
+      observedBytes += value.byteLength;
+      if (observedBytes > expectedSize) {
+        throw new Error(
+          `CI stream exceeded its declared size for ${key}: expected ${expectedSize}, observed at least ${observedBytes}`,
+        );
+      }
+      buffered.push(value);
+      bufferedBytes += value.byteLength;
+      while (bufferedBytes >= MULTIPART_PART_BYTES) {
+        const part = takeBufferedBytes(buffered, MULTIPART_PART_BYTES);
+        bufferedBytes -= part.byteLength;
+        parts.push(await upload.uploadPart(partNumber++, part));
+      }
+    }
+    if (observedBytes !== expectedSize) {
+      throw new Error(
+        `CI stream ended at the wrong size for ${key}: expected ${expectedSize}, observed ${observedBytes}`,
+      );
+    }
+    if (bufferedBytes > 0 || parts.length === 0) {
+      const part = takeBufferedBytes(buffered, bufferedBytes);
+      bufferedBytes -= part.byteLength;
+      parts.push(await upload.uploadPart(partNumber, part));
+    }
+    const object = await upload.complete(parts);
+    if (object.key !== key || object.size !== expectedSize) {
+      await bucket.delete(key).catch(() => undefined);
+      throw new Error(
+        `CI multipart upload size mismatch for ${key}: expected ${expectedSize}, stored ${object.size}`,
+      );
+    }
+    return object;
+  } catch (error) {
+    await reader.cancel(error).catch(() => undefined);
+    await upload.abort().catch(() => undefined);
+    throw error;
+  } finally {
+    reader.releaseLock();
+  }
+}
+
+function takeBufferedBytes(buffered, size) {
+  const part = new Uint8Array(size);
+  let offset = 0;
+  while (offset < size) {
+    const chunk = buffered[0];
+    if (!chunk) throw new Error("CI multipart stream buffer underflow");
+    const length = Math.min(chunk.byteLength, size - offset);
+    part.set(chunk.subarray(0, length), offset);
+    offset += length;
+    if (length === chunk.byteLength) {
+      buffered.shift();
+    } else {
+      buffered[0] = chunk.subarray(length);
+    }
+  }
+  return part;
+}
