review_directory := justfile_directory()
repository_directory := review_directory + "/../.."

build:
    cd "{{ review_directory }}" && bun run build

dev:
    cd "{{ review_directory }}" && bun run dev

# Build and link these assets into the path used by development Nanocodex builds.
install-dev: build
    #!/usr/bin/env bash
    set -euo pipefail

    review_directory="{{ review_directory }}"
    repository_directory="{{ repository_directory }}"
    version=$(
        cargo metadata \
            --manifest-path "$repository_directory/Cargo.toml" \
            --no-deps \
            --format-version 1 |
            bun -e '
                const metadata = await Bun.stdin.json();
                const nanocodex = metadata.packages.find((candidate) => candidate.name === "nanocodex-bin");
                if (!nanocodex) throw new Error("nanocodex-bin package not found");
                process.stdout.write(nanocodex.version);
            '
    )

    if [[ -n "${NANOCODEX_HOME:-}" ]]; then
        tact_directory="$NANOCODEX_HOME"
    elif [[ -n "${HOME:-}" ]]; then
        tact_directory="$HOME/.nanocodex"
    elif [[ -n "${USERPROFILE:-}" ]]; then
        tact_directory="$USERPROFILE/.nanocodex"
    else
        echo "could not determine the Nanocodex directory; set NANOCODEX_HOME" >&2
        exit 1
    fi

    destination="$tact_directory/review/v$version"
    mkdir -p "$(dirname "$destination")"

    if [[ -e "$destination" && ! -L "$destination" ]]; then
        echo "refusing to replace non-symlink review assets at $destination" >&2
        exit 1
    fi

    rm -f -- "$destination"
    ln -s -- "$review_directory/dist" "$destination"
    printf 'Installed development review assets at %s\n' "$destination"
