{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nanocodex-dynamic-apps-branch-poc",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./dist/nanocodex/index.js",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  },
  "rules": [
    { "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/apps",
      "/apps/*",
      "/auth",
      "/auth/*",
      "/webauthn/*",
      "/v1/*",
      "/api/health"
    ]
  },
  "services": [
    {
      "binding": "NANOCODEX_BACKEND",
      "service": "nanocodex-dynamic-apps-managed-poc"
    },
    {
      "binding": "NANOCODEX_CONNECT_DIALOG",
      "service": "nanocodex-connect-dialog"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "THREAD_GIT_REPOSITORY",
        "class_name": "ThreadGitRepository"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ThreadGitRepository"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "GIT_OBJECTS",
      "bucket_name": "nanocodex-git"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  }
}
