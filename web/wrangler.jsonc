{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nanocodex",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/entry.ts",
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  },
  "triggers": {
    "crons": ["0 5 * * *"]
  },
  "secrets": {
    "required": ["GIT_MIRROR_TOKEN", "CI_MASTER_SOURCE_WRITE_TOKEN", "CI_PR_SOURCE_WRITE_TOKEN", "CI_CONTROL_TOKEN", "CI_MACOS_RUNNER_TOKEN", "CI_RELEASE_TOKEN", "NANOCODEX_SANDBOX_CONTROL_TOKEN", "R2_ACCESS_KEY_ID", "R2_SECRET_ACCESS_KEY"]
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": [
      "/",
      "/agent",
      "/artifact-runtime",
      "/changelog",
      "/code",
      "/commits",
      "/requests",
      "/ci",
      "/docs",
      "/docs/*",
      "/evals",
      "/evals/*",
      "/og.png",
      "/api/*",
      "/v1/*",
      "/git/*",
      "/.well-known/urpc/consumer.json"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BYOK_SESSIONS",
        "class_name": "ByokSession"
      },
      {
        "name": "CHATGPT_SESSIONS",
        "class_name": "ChatGptSession"
      },
      {
        "name": "GIT_REPOSITORY",
        "class_name": "GitRepository"
      },
      {
        "name": "THREAD_GIT_REPOSITORY",
        "class_name": "ThreadGitRepository"
      },
      {
        "name": "EVAL_COORDINATOR",
        "class_name": "EvalCoordinator"
      },
      {
        "name": "CHATGPT_EGRESS",
        "class_name": "ChatGptEgress"
      },
      {
        "name": "CI_REPOSITORY",
        "class_name": "CiRepository"
      },
      {
        "name": "CI_MACOS_JOBS",
        "class_name": "CiMacJobs"
      },
      {
        "name": "CI_RELEASES",
        "class_name": "CiReleases"
      },
      {
        "name": "SANDBOX",
        "class_name": "CiSandbox"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ByokSession"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ChatGptSession"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["GitRepository"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["EvalCoordinator"]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["ChatGptEgress"]
    },
    {
      "tag": "v6",
      "new_sqlite_classes": ["ThreadGitRepository"]
    },
    {
      "tag": "v7",
      "new_sqlite_classes": ["GuestQuota"]
    },
    {
      "tag": "v8",
      "deleted_classes": ["GuestQuota"]
    },
    {
      "tag": "v9",
      "new_sqlite_classes": ["CiRepository", "CiSandbox"]
    },
    {
      "tag": "v10",
      "new_sqlite_classes": ["CiMacJobs", "CiReleases"]
    }
  ],
  "workflows": [
    {
      "binding": "CI_WORKFLOW",
      "name": "nanocodex-ci",
      "class_name": "NanocodexCI"
    }
  ],
  "containers": [
    {
      "class_name": "ChatGptEgress",
      "image": "./container/Dockerfile",
      "max_instances": 1000,
      "instance_type": "lite"
    },
    {
      "class_name": "CiSandbox",
      "image": "./ci/Dockerfile",
      "max_instances": 32,
      "instance_type": "standard-4"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_START_LIMIT",
      "namespace_id": "987601",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "AUTH_GLOBAL_LIMIT",
      "namespace_id": "987602",
      "simple": { "limit": 100, "period": 60 }
    },
    {
      "name": "SESSION_POLL_LIMIT",
      "namespace_id": "987603",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "AGENT_SOCKET_LIMIT",
      "namespace_id": "987604",
      "simple": { "limit": 12, "period": 60 }
    },
    {
      "name": "AGENT_TOOL_LIMIT",
      "namespace_id": "987605",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "AGENT_IMAGE_LIMIT",
      "namespace_id": "987606",
      "simple": { "limit": 4, "period": 60 }
    }
  ],
  "r2_buckets": [
    {
      "binding": "GIT_OBJECTS",
      "bucket_name": "nanocodex-git"
    },
    {
      "binding": "EVALS_ARTIFACTS",
      "bucket_name": "nanocodex-evals"
    },
    {
      "binding": "CI_SOURCE",
      "bucket_name": "nanocodex-ci-source"
    },
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "nanocodex-ci"
    }
  ],
  "d1_databases": [
    {
      "binding": "EVALS_DB",
      "database_name": "nanocodex-evals",
      "database_id": "b5a4b6e9-8e9f-489a-b0af-b1813d97dcd5",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "BACKUP_BUCKET_NAME": "nanocodex-ci",
    "CI_PUBLIC_ORIGIN": "https://nanocodex.me-7fb.workers.dev",
    "CLOUDFLARE_ACCOUNT_ID": "7fb82fc3b80331b2cd45f097acbd9ffc"
  },
  "env": {
    "development": {
      "name": "nanocodex-development",
      "triggers": { "crons": [] },
      "secrets": {
        "required": ["GIT_MIRROR_TOKEN", "CI_MASTER_SOURCE_WRITE_TOKEN", "CI_PR_SOURCE_WRITE_TOKEN", "CI_CONTROL_TOKEN", "CI_MACOS_RUNNER_TOKEN", "CI_RELEASE_TOKEN", "NANOCODEX_SANDBOX_CONTROL_TOKEN", "R2_ACCESS_KEY_ID", "R2_SECRET_ACCESS_KEY"]
      },
      "durable_objects": {
        "bindings": [
          { "name": "BYOK_SESSIONS", "class_name": "ByokSession" },
          { "name": "CHATGPT_SESSIONS", "class_name": "ChatGptSession" },
          { "name": "GIT_REPOSITORY", "class_name": "GitRepository" },
          { "name": "THREAD_GIT_REPOSITORY", "class_name": "ThreadGitRepository" },
          { "name": "EVAL_COORDINATOR", "class_name": "EvalCoordinator" },
          { "name": "CHATGPT_EGRESS", "class_name": "ChatGptEgress" },
          { "name": "CI_REPOSITORY", "class_name": "CiRepository" },
          { "name": "CI_MACOS_JOBS", "class_name": "CiMacJobs" },
          { "name": "CI_RELEASES", "class_name": "CiReleases" },
          { "name": "SANDBOX", "class_name": "CiSandbox" }
        ]
      },
      "workflows": [
        { "binding": "CI_WORKFLOW", "name": "nanocodex-ci-development", "class_name": "NanocodexCI" }
      ],
      "containers": [
        {
          "class_name": "ChatGptEgress",
          "image": "./container/Dockerfile",
          "max_instances": 1000,
          "instance_type": "lite"
        },
        {
          "class_name": "CiSandbox",
          "image": "./ci/Dockerfile",
          "max_instances": 10,
          "instance_type": "standard-4"
        }
      ],
      "ratelimits": [
        { "name": "AUTH_START_LIMIT", "namespace_id": "987601", "simple": { "limit": 5, "period": 60 } },
        { "name": "AUTH_GLOBAL_LIMIT", "namespace_id": "987602", "simple": { "limit": 100, "period": 60 } },
        { "name": "SESSION_POLL_LIMIT", "namespace_id": "987603", "simple": { "limit": 120, "period": 60 } },
        { "name": "AGENT_SOCKET_LIMIT", "namespace_id": "987604", "simple": { "limit": 12, "period": 60 } },
        { "name": "AGENT_TOOL_LIMIT", "namespace_id": "987605", "simple": { "limit": 30, "period": 60 } },
        { "name": "AGENT_IMAGE_LIMIT", "namespace_id": "987606", "simple": { "limit": 4, "period": 60 } }
      ],
      "r2_buckets": [
        { "binding": "GIT_OBJECTS", "bucket_name": "nanocodex-git", "remote": true },
        { "binding": "EVALS_ARTIFACTS", "bucket_name": "nanocodex-evals", "remote": true },
        { "binding": "CI_SOURCE", "bucket_name": "nanocodex-ci-source-development" },
        { "binding": "BACKUP_BUCKET", "bucket_name": "nanocodex-ci-development" }
      ],
      "d1_databases": [
        {
          "binding": "EVALS_DB",
          "database_name": "nanocodex-evals",
          "database_id": "b5a4b6e9-8e9f-489a-b0af-b1813d97dcd5",
          "migrations_dir": "migrations",
          "remote": true
        }
      ],
      "vars": {
        "ENVIRONMENT": "development",
        "BACKUP_BUCKET_NAME": "nanocodex-ci-development",
        "CI_PUBLIC_ORIGIN": "http://host.docker.internal:8787",
        "CLOUDFLARE_ACCOUNT_ID": "7fb82fc3b80331b2cd45f097acbd9ffc"
      }
    },
    "preview": {
      "name": "nanocodex-preview",
      "triggers": { "crons": [] },
      "secrets": {
        "required": ["GIT_MIRROR_TOKEN", "CI_MASTER_SOURCE_WRITE_TOKEN", "CI_PR_SOURCE_WRITE_TOKEN", "CI_CONTROL_TOKEN", "CI_MACOS_RUNNER_TOKEN", "CI_RELEASE_TOKEN", "NANOCODEX_SANDBOX_CONTROL_TOKEN", "R2_ACCESS_KEY_ID", "R2_SECRET_ACCESS_KEY"]
      },
      "durable_objects": {
        "bindings": [
          { "name": "BYOK_SESSIONS", "class_name": "ByokSession" },
          { "name": "CHATGPT_SESSIONS", "class_name": "ChatGptSession" },
          { "name": "GIT_REPOSITORY", "class_name": "GitRepository" },
          { "name": "THREAD_GIT_REPOSITORY", "class_name": "ThreadGitRepository" },
          { "name": "EVAL_COORDINATOR", "class_name": "EvalCoordinator" },
          { "name": "CHATGPT_EGRESS", "class_name": "ChatGptEgress" },
          { "name": "CI_REPOSITORY", "class_name": "CiRepository" },
          { "name": "CI_MACOS_JOBS", "class_name": "CiMacJobs" },
          { "name": "CI_RELEASES", "class_name": "CiReleases" },
          { "name": "SANDBOX", "class_name": "CiSandbox" }
        ]
      },
      "workflows": [
        { "binding": "CI_WORKFLOW", "name": "nanocodex-ci-preview", "class_name": "NanocodexCI" }
      ],
      "containers": [
        {
          "class_name": "ChatGptEgress",
          "image": "./container/Dockerfile",
          "max_instances": 1000,
          "instance_type": "lite"
        },
        {
          "class_name": "CiSandbox",
          "image": "./ci/Dockerfile",
          "max_instances": 10,
          "instance_type": "standard-4"
        }
      ],
      "ratelimits": [
        { "name": "AUTH_START_LIMIT", "namespace_id": "987611", "simple": { "limit": 5, "period": 60 } },
        { "name": "AUTH_GLOBAL_LIMIT", "namespace_id": "987612", "simple": { "limit": 100, "period": 60 } },
        { "name": "SESSION_POLL_LIMIT", "namespace_id": "987613", "simple": { "limit": 120, "period": 60 } },
        { "name": "AGENT_SOCKET_LIMIT", "namespace_id": "987614", "simple": { "limit": 12, "period": 60 } },
        { "name": "AGENT_TOOL_LIMIT", "namespace_id": "987615", "simple": { "limit": 30, "period": 60 } },
        { "name": "AGENT_IMAGE_LIMIT", "namespace_id": "987616", "simple": { "limit": 4, "period": 60 } }
      ],
      "r2_buckets": [
        { "binding": "GIT_OBJECTS", "bucket_name": "nanocodex-git-preview" },
        { "binding": "EVALS_ARTIFACTS", "bucket_name": "nanocodex-evals-preview" },
        { "binding": "CI_SOURCE", "bucket_name": "nanocodex-ci-source-preview" },
        { "binding": "BACKUP_BUCKET", "bucket_name": "nanocodex-ci-preview" }
      ],
      "d1_databases": [
        {
          "binding": "EVALS_DB",
          "database_name": "nanocodex-evals-preview",
          "database_id": "d201368e-d5ad-4246-bb43-1d88522fbf63",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "ENVIRONMENT": "preview",
        "BACKUP_BUCKET_NAME": "nanocodex-ci-preview",
        "CI_PUBLIC_ORIGIN": "https://nanocodex-preview.gakonst.workers.dev",
        "CLOUDFLARE_ACCOUNT_ID": "16ce0442a940f01beefdb15a196a43ea"
      }
    }
  }
}
